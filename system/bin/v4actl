#!/system/bin/sh
# v4actl: enable/disable/restart ViPER4Android FX service quickly.
PROP="persist.v4a.enabled"
TAG="V4A-CTL"

logi(){ log -t "$TAG" "$*"; echo "$*"; }

usage(){
  echo "Usage: v4actl [on|off|toggle|status|restart]"
  exit 1
}

get_status(){
  val="$(getprop $PROP)"
  [ -z "$val" ] && val="1"
  echo "$val"
}

case "$1" in
  on)
    setprop $PROP 1
    logi "Enabled ($PROP=1); poking V4A"
    am broadcast -a com.pittvandewitt.viperfx.START >/dev/null 2>&1
    am broadcast -a com.pittvandewitt.viperfx.RESTART >/dev/null 2>&1
    ;;
  off)
    setprop $PROP 0
    logi "Disabled ($PROP=0); stopping effects"
    # Try to unload effect by gently restarting audioserver
    killall audioserver >/dev/null 2>&1
    ;;
  toggle)
    cur="$(get_status)"
    if [ "$cur" = "1" ]; then "$0" off; else "$0" on; fi
    ;;
  status)
    cur="$(get_status)"
    if [ "$cur" = "1" ]; then echo "V4A: enabled"; else echo "V4A: disabled"; fi
    ;;
  restart)
    logi "Restarting audioserver to refresh effects"
    killall audioserver >/dev/null 2>&1
    ;;
  *)
    usage
    ;;
esac
